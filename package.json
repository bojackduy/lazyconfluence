{
  "name": "@bojackduy/lazyconfluence",
  "version": "3.1.22",
  "description": "Terminal-first Confluence document browser.",
  "homepage": "https://bojackduy.github.io/lazyconfluence/",
  "private": false,
  "type": "module",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/bojackduy/lazyconfluence.git"
  },
  "bugs": {
    "url": "https://github.com/bojackduy/lazyconfluence/issues"
  },
  "keywords": [
    "atlassian",
    "cli",
    "confluence",
    "documentation",
    "terminal",
    "tui"
  ],
  "bin": {
    "lazyconfluence": "dist/main.js"
  },
  "files": [
    "dist",
    "README.md"
  ],
  "publishConfig": {
    "access": "public"
  },
  "engines": {
    "bun": ">=1.1.0"
  },
  "scripts": {
    "start": "bun run src/main.tsx",
    "start:dev": "bun run src/main.tsx dev",
    "start:prod": "bun run src/main.tsx prod",
    "build": "bun run scripts/build.ts",
    "typecheck": "tsc --noEmit",
    "test": "bun --conditions=browser test",
    "lint": "bun run typecheck",
    "release:patch": "bun run typecheck && bun run test && npm version patch -m \"chore: release %s\" && git push && git push origin $(git describe --tags --abbrev=0)",
    "release:minor": "bun run typecheck && bun run test && npm version minor -m \"minor: release %s\" && git push && git push origin $(git describe --tags --abbrev=0)",
    "release:major": "bun run typecheck && bun run test && npm version major -m \"major: release %s\" && git push && git push origin $(git describe --tags --abbrev=0)"
  },
  "dependencies": {
    "@opentui/core": "0.4.5",
    "@opentui/solid": "0.4.5",
    "@resvg/resvg-js": "^2.6.2",
    "gifuct-js": "^2.1.2",
    "jpeg-js": "^0.4.4",
    "playwright-core": "^1.62.0",
    "solid-js": "1.9.14"
  },
  "devDependencies": {
    "@types/bun": "1.3.14",
    "typescript": "7.0.2"
  }
}
